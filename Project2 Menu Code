#include <iostream>
#include <fstream>
#include <sstream>
#include <string>
#include <vector>
#include <algorithm>

using namespace std;

/**
 * @brief Represents a course node in the binary search tree.
 *
 * This structure holds the details of a course, including its ID, title, and prerequisites.
 * It also contains pointers to the left and right child nodes in the binary search tree.
 */
struct Course {
    string courseId; /**< The unique identifier for the course. */
    string title; /**< The title of the course. */
    vector<string> prerequisites; /**< A list of course IDs representing prerequisites. */
    Course* left; /**< Pointer to the left child node in the BST. */
    Course* right; /**< Pointer to the right child node in the BST. */

    /**
     * @brief Constructor to initialize a Course object.
     *
     * @param id The unique course ID.
     * @param name The title of the course.
     */
    Course(string id, string name) : courseId(id), title(name), left(nullptr), right(nullptr) {}
};

/**
 * @brief A binary search tree to manage courses.
 *
 * This class provides functionalities to insert, search, and print course details.
 */
class CourseBST {
private:
    Course* root; /**< The root node of the binary search tree. */

    /**
     * @brief Helper function to insert a course into the BST.
     *
     * @param node The current node in the BST.
     * @param newCourse The new course to insert.
     */
    void insert(Course*& node, Course* newCourse) {
        if (node == nullptr) {
            node = newCourse;
        }
        else if (newCourse->courseId < node->courseId) {
            insert(node->left, newCourse);
        }
        else {
            insert(node->right, newCourse);
        }
    }

    /**
     * @brief Helper function for in-order traversal of the BST.
     *
     * This function prints all courses in alphabetical order.
     * @param node The current node in the BST.
     */
    void inOrder(Course* node) const {
        if (node != nullptr) {
            inOrder(node->left);
            cout << node->courseId << ", " << node->title << endl;
            inOrder(node->right);
        }
    }

    /**
     * @brief Helper function to search for a course by its ID.
     *
     * @param node The current node in the BST.
     * @param courseId The ID of the course to search for.
     * @return A pointer to the course if found, otherwise nullptr.
     */
    Course* search(Course* node, const string& courseId) const {
        if (node == nullptr || node->courseId == courseId) {
            return node;
        }
        else if (courseId < node->courseId) {
            return search(node->left, courseId);
        }
        else {
            return search(node->right, courseId);
        }
    }

public:
    /**
     * @brief Constructor to initialize an empty CourseBST.
     */
    CourseBST() : root(nullptr) {}

    /**
     * @brief Inserts a new course into the BST.
     *
     * @param courseId The unique ID of the course.
     * @param title The title of the course.
     * @param prerequisites A list of course IDs representing prerequisites.
     */
    void insertCourse(const string& courseId, const string& title, const vector<string>& prerequisites) {
        Course* newCourse = new Course(courseId, title);
        newCourse->prerequisites = prerequisites;
        insert(root, newCourse);
    }

    /**
     * @brief Prints all courses in alphabetical order.
     */
    void printCourses() const {
        inOrder(root);
    }

    /**
     * @brief Prints the details of a specific course.
     *
     * @param courseId The ID of the course to print.
     */
    void printCourse(const string& courseId) const {
        Course* course = search(root, courseId);
        if (course != nullptr) {
            cout << course->courseId << ", " << course->title << endl;
            if (!course->prerequisites.empty()) {
                cout << "Prerequisites: ";
                for (const string& prereq : course->prerequisites) {
                    cout << prereq << " ";
                }
                cout << endl;
            }
            else {
                cout << "No prerequisites." << endl;
            }
        }
        else {
            cout << "Course not found." << endl;
        }
    }
};

/**
 * @brief Loads course data from a CSV file into a CourseBST.
 *
 * This function reads the contents of a CSV file, extracts course information,
 * and inserts the courses into the given CourseBST object.
 *
 * @param filename The name of the CSV file to read.
 * @param bst The CourseBST object to populate.
 */
void loadData(const string& filename, CourseBST& bst) {
    ifstream file(filename);
    if (!file.is_open()) {
        cerr << "Error: Unable to open file " << filename << endl;
        return;
    }

    string line;
    while (getline(file, line)) {
        stringstream ss(line);
        string courseId, title, prereq;
        vector<string> prerequisites;

        getline(ss, courseId, ',');
        getline(ss, title, ',');

        while (getline(ss, prereq, ',')) {
            prerequisites.push_back(prereq);
        }

        bst.insertCourse(courseId, title, prerequisites);
    }

    file.close();
    cout << "Data loaded successfully." << endl;
}

/**
 * @brief Main function to execute the course planner program.
 *
 * This function provides a menu-driven interface for the user to load course data,
 * view the course list, search for course details, or exit the program.
 *
 * @return Exit status of the program.
 */
int main() {
    CourseBST coursePlanner; /**< The binary search tree to manage courses. */
    string filename; /**< The name of the file containing course data. */
    int choice; /**< User's menu choice. */

    do {
        // Display menu
        cout << "\nWelcome to the course planner.\n";
        cout << "1. Load Data Structure.\n";
        cout << "2. Print Course List.\n";
        cout << "3. Print Course.\n";
        cout << "9. Exit.\n";
        cout << "What would you like to do? ";
        cin >> choice;

        switch (choice) {
        case 1:
            filename = "CS 300 ABCU_Advising_Program_Input.csv";
            loadData(filename, coursePlanner);
            break;
        case 2:
            cout << "Here is a sample schedule:" << endl;
            coursePlanner.printCourses();
            break;
        case 3: {
            string courseId;
            cout << "What course do you want to know about? ";
            cin >> courseId;
            coursePlanner.printCourse(courseId);
            break;
        }
        case 9:
            cout << "Thank you for using the course planner!" << endl;
            break;
        default:
            cout << choice << " is not a valid option." << endl;
        }
    } while (choice != 9);

    return 0;
}
